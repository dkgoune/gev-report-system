generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==================== ENUMS ====================

enum SystemRole {
  standard
  super_admin
}

enum WorkScheduleStatus {
  draft
  published
  archived
}

enum IncidentTemplateVersionStatus {
  draft
  published
  archived
}

enum AttendanceStatus {
  scheduled
  present
  absent
  excused
}

enum IncidentFieldType {
  text
  textarea
  number
  boolean
  date
  time
  select
  multiselect
}

enum UserPermission {
  // Dashboard
  dashboard_view
  dashboard_analytics_view
  dashboard_evaluations_view

  // Users
  user_create
  user_read
  user_update
  user_delete
  user_reset_password
  user_enable_disable
  user_manage_permissions

  // Services
  service_create
  service_read
  service_update
  service_delete
  service_enable_disable

  // Posts
  post_create
  post_read
  post_update
  post_delete
  post_enable_disable

  // Work schedules
  work_schedule_create
  work_schedule_read
  work_schedule_update
  work_schedule_delete
  work_schedule_publish
  work_schedule_print

  // Reports
  report_create
  report_read
  report_update
  report_mark_read
  report_read_all_incidents

  // Incidents
  incident_template_manage
  incident_template_read
  incident_binding_manage

  // Criteria
  criteria_create
  criteria_read
  criteria_update
  criteria_enable_disable

  // Evaluations
  evaluation_create
  evaluation_read

  // Signatures
  signature_create
  signature_read
  signature_update

  // Settings
  settings_view
  settings_attendance_rules_view
  settings_attendance_rules_create
  settings_attendance_rules_update
  settings_attendance_rules_delete
  settings_attendance_rules_enable_disable

  // Agencies (super admin area)
  agency_create
  agency_read
  agency_update
  agency_delete
}

enum GeneralReportStatus {
  draft
  published
}

enum GeneralReportPersonnelStatus {
  present
  absent
}

enum AttendanceCriterionTarget {
  present
  absent
  both
}

// ==================== TENANCY & IDENTITY ====================

model Agency {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  memberships                 UserAgencyMembership[]
  serviceDefinitions          ServiceDefinition[]
  posts                       WorkPost[]
  workSchedules               WorkSchedule[]
  incidentTemplates           IncidentTemplate[]
  criteria                    Criterion[]
  attendanceCriterionSettings AttendanceCriterionSetting[]
  roles                       Role[]

  @@map("agencies")
}

model User {
  id         String     @id @default(cuid())
  username   String     @unique
  password   String
  fullName   String
  phone      String?
  systemRole SystemRole @default(standard)
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  // Relations
  memberships               UserAgencyMembership[]
  createdServices           ServiceDefinition[]
  createdPosts              WorkPost[]
  createdSchedules          WorkSchedule[]
  createdIncidentTemplates  IncidentTemplate[]
  createdIncidentVersions   IncidentTemplateVersion[]
  createdCriteria           Criterion[]
  createdAttendanceSettings AttendanceCriterionSetting[]

  evaluationsReceived PersonnelEvaluation[] @relation("EvaluatedUser")
  evaluationsGiven    PersonnelEvaluation[] @relation("EvaluatingLeader")

  generalReportsCreated GeneralReport[]                    @relation("GeneralReportReporter")
  generalReportsRead    GeneralReport[]                    @relation("GeneralReportReader")
  reportAttendances     GeneralReportPersonnelAttendance[]

  workScheduleAssignments    WorkScheduleAssignment[]
  signatureLogs              SignatureLog[]
  createdRoles               Role[]                   @relation("CreatedRoles")

  @@map("users")
}

model UserAgencyMembership {
  id        String   @id @default(cuid())
  userId    String
  agencyId  String
  isActive  Boolean  @default(true)
  joinedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  roles  Role[]

  @@unique([userId, agencyId])
  @@index([userId])
  @@index([agencyId])
  @@map("user_agency_memberships")
}

// ==================== AGENCY CONFIGURATION ====================

model ServiceDefinition {
  id          String   @id @default(cuid())
  agencyId    String
  name        String
  code        String
  description String?
  color       String? // hex color for UI
  isActive    Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  agency           Agency                   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  createdBy        User                     @relation(fields: [createdById], references: [id])
  workSchedules    WorkSchedule[]
  incidentBindings ServiceIncidentBinding[]

  @@unique([agencyId, code])
  @@index([agencyId])
  @@index([createdById])
  @@map("service_definitions")
}

model WorkPost {
  id          String   @id @default(cuid())
  agencyId    String
  name        String
  code        String
  description String?
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  agency              Agency                   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  createdBy           User                     @relation(fields: [createdById], references: [id])
  scheduleAssignments WorkScheduleAssignment[]
  allowedTemplates    IncidentTemplate[]       @relation("IncidentTemplateToWorkPost")

  @@unique([agencyId, code])
  @@index([agencyId])
  @@index([createdById])
  @@map("posts")
}

// ==================== WORK SCHEDULING ====================

model WorkSchedule {
  id          String             @id @default(cuid())
  agencyId    String
  serviceId   String
  workDate    DateTime           @db.Date
  status      WorkScheduleStatus @default(draft)
  createdById String
  publishedAt DateTime?
  archivedAt  DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  // Relations
  agency               Agency                            @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  service              ServiceDefinition                 @relation(fields: [serviceId], references: [id])
  createdBy            User                              @relation(fields: [createdById], references: [id])
  assignments          WorkScheduleAssignment[]
  incidentRequirements WorkScheduleIncidentRequirement[]
  generalReport        GeneralReport?
  evaluations          PersonnelEvaluation[]
  incidentEntries      GeneralReportIncidentEntry[]

  @@unique([agencyId, serviceId, workDate])
  @@index([agencyId])
  @@index([serviceId])
  @@index([createdById])
  @@map("work_schedules")
}

model WorkScheduleAssignment {
  id               String           @id @default(cuid())
  workScheduleId   String
  userId           String
  postId           String
  isLeader         Boolean          @default(false)
  isSubleader      Boolean          @default(false)
  attendanceStatus AttendanceStatus @default(scheduled)
  createdAt        DateTime         @default(now())

  // Relations
  workSchedule WorkSchedule @relation(fields: [workScheduleId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])
  post         WorkPost     @relation(fields: [postId], references: [id])

  @@unique([workScheduleId, userId])
  @@index([workScheduleId])
  @@index([userId])
  @@index([postId])
  @@map("work_schedule_assignments")
}

// ==================== INCIDENT TEMPLATE SYSTEM ====================

model IncidentTemplate {
  id          String   @id @default(cuid())
  agencyId    String
  name        String
  code        String
  description String?
  icon        String?
  isActive    Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  agency                           Agency                            @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  createdBy                        User                              @relation(fields: [createdById], references: [id])
  versions                         IncidentTemplateVersion[]
  serviceBindings                  ServiceIncidentBinding[]
  reportIncidentEntries            GeneralReportIncidentEntry[]
  workScheduleIncidentRequirements WorkScheduleIncidentRequirement[]
  allowedPosts                     WorkPost[]                        @relation("IncidentTemplateToWorkPost")

  @@unique([agencyId, code])
  @@index([agencyId])
  @@index([createdById])
  @@map("incident_templates")
}

model IncidentTemplateVersion {
  id          String                        @id @default(cuid())
  templateId  String
  version     Int
  fieldsJson  Json // Array of field definitions with key, label, type, required, etc.
  status      IncidentTemplateVersionStatus @default(draft)
  publishedAt DateTime?
  createdById String
  createdAt   DateTime                      @default(now())

  // Relations
  template                         IncidentTemplate                  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  createdBy                        User                              @relation(fields: [createdById], references: [id])
  serviceBindings                  ServiceIncidentBinding[]
  reportIncidentEntries            GeneralReportIncidentEntry[]
  workScheduleIncidentRequirements WorkScheduleIncidentRequirement[]

  @@unique([templateId, version])
  @@index([templateId])
  @@index([createdById])
  @@map("incident_template_versions")
}

model ServiceIncidentBinding {
  id                String   @id @default(cuid())
  serviceId         String
  templateId        String
  templateVersionId String
  minEntries        Int      @default(0)
  maxEntries        Int? // null = unlimited
  isRequired        Boolean  @default(false)
  displayOrder      Int
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  service         ServiceDefinition       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  template        IncidentTemplate        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateVersion IncidentTemplateVersion @relation(fields: [templateVersionId], references: [id])

  @@unique([serviceId, templateId])
  @@index([serviceId])
  @@index([templateId])
  @@index([templateVersionId])
  @@map("service_incident_bindings")
}

model WorkScheduleIncidentRequirement {
  id                       String   @id @default(cuid())
  workScheduleId           String
  serviceIncidentBindingId String
  templateId               String
  templateVersionId        String
  configSnapshotJson       Json // Immutable snapshot of binding config + template fields
  displayOrder             Int
  isActive                 Boolean  @default(true)
  createdAt                DateTime @default(now())

  // Relations
  workSchedule    WorkSchedule            @relation(fields: [workScheduleId], references: [id], onDelete: Cascade)
  template        IncidentTemplate        @relation(fields: [templateId], references: [id])
  templateVersion IncidentTemplateVersion @relation(fields: [templateVersionId], references: [id])

  @@index([workScheduleId])
  @@index([templateId])
  @@index([templateVersionId])
  @@map("work_schedule_incident_requirements")
}

// ==================== GENERAL REPORT & INCIDENT ENTRIES ====================

model GeneralReport {
  id             String              @id @default(cuid())
  workScheduleId String              @unique
  reportedById   String
  readById       String?
  isRead         Boolean             @default(false)
  status         GeneralReportStatus @default(draft)
  publishedAt    DateTime?
  readAt         DateTime?

  // General report structured fields
  ambianceGenerale    String? @db.Text
  problemesRencontres String? @db.Text
  etatGeneralService  String? @db.Text
  passationService    String? @db.Text
  observationGeneral  String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  workSchedule    WorkSchedule                       @relation(fields: [workScheduleId], references: [id], onDelete: Cascade)
  reportedBy      User                               @relation("GeneralReportReporter", fields: [reportedById], references: [id])
  readBy          User?                              @relation("GeneralReportReader", fields: [readById], references: [id])
  incidentEntries GeneralReportIncidentEntry[]
  attendances     GeneralReportPersonnelAttendance[]

  @@index([workScheduleId])
  @@index([reportedById])
  @@index([readById])
  @@index([status])
  @@map("general_reports")
}

model GeneralReportIncidentEntry {
  id                   String   @id @default(cuid())
  generalReportId      String
  workScheduleId       String
  templateId           String
  templateVersionId    String
  templateNameSnapshot String // Immutable snapshot of template name
  templateCodeSnapshot String // Immutable snapshot of template code
  valuesJson           Json // Submitted field values
  schemaSnapshotJson   Json // Snapshot of field schema used
  displayOrder         Int
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // Relations
  generalReport   GeneralReport           @relation(fields: [generalReportId], references: [id], onDelete: Cascade)
  workSchedule    WorkSchedule            @relation(fields: [workScheduleId], references: [id], onDelete: Cascade)
  template        IncidentTemplate        @relation(fields: [templateId], references: [id])
  templateVersion IncidentTemplateVersion @relation(fields: [templateVersionId], references: [id])

  @@index([generalReportId])
  @@index([workScheduleId])
  @@index([templateId])
  @@index([templateVersionId])
  @@map("general_report_incident_entries")
}

model GeneralReportPersonnelAttendance {
  id              String                       @id @default(cuid())
  generalReportId String
  userId          String
  status          GeneralReportPersonnelStatus
  createdAt       DateTime                     @default(now())

  generalReport GeneralReport @relation(fields: [generalReportId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([generalReportId, userId])
  @@index([generalReportId])
  @@index([userId])
  @@index([status])
  @@map("general_report_personnel_attendances")
}

// ==================== EVALUATIONS ====================

model Criterion {
  id          String   @id @default(cuid())
  agencyId    String
  name        String
  impact      String // "low" | "high"
  weight      Decimal  @default(1) @db.Decimal(10, 2)
  maxDaily    Int
  isActive    Boolean  @default(true)
  requiresPersonnel Boolean @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  agency             Agency                       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  createdBy          User                         @relation(fields: [createdById], references: [id])
  evaluations        PersonnelEvaluation[]
  attendanceSettings AttendanceCriterionSetting[]

  @@unique([agencyId, name])
  @@index([agencyId])
  @@index([createdById])
  @@map("criteria")
}

model PersonnelEvaluation {
  id                 String   @id @default(cuid())
  workScheduleId     String?
  evaluatedUserId    String?
  evaluatingLeaderId String
  criterionId        String
  score              Int      @default(0)
  comment            String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  evaluationDate     DateTime @default(now())
  isCancelled        Boolean  @default(false)
  cancelledAt        DateTime?

  // Relations
  workSchedule     WorkSchedule? @relation(fields: [workScheduleId], references: [id], onDelete: Cascade)
  evaluatedUser    User?        @relation("EvaluatedUser", fields: [evaluatedUserId], references: [id])
  evaluatingLeader User         @relation("EvaluatingLeader", fields: [evaluatingLeaderId], references: [id])
  criterion        Criterion    @relation(fields: [criterionId], references: [id])

  @@index([workScheduleId])
  @@index([evaluatedUserId])
  @@index([evaluatingLeaderId])
  @@index([criterionId])
  @@map("personnel_evaluations")
}

model AttendanceCriterionSetting {
  id          String                    @id @default(cuid())
  agencyId    String
  criterionId String
  appliesTo   AttendanceCriterionTarget @default(both)
  isEnabled   Boolean                   @default(true)
  createdById String
  createdAt   DateTime                  @default(now())

  // Relations
  agency    Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  criterion Criterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id])

  @@index([agencyId])
  @@index([criterionId])
  @@index([createdById])
  @@map("attendance_criterion_settings")
}

// ==================== SIGNATURE LOGS ====================

model SignatureLog {
  id             String    @id @default(cuid())
  userId         String
  signatureCount Int       @default(1)
  signedAt       DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  user         User         @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("signature_logs")
}

model Role {
  id          String           @id @default(cuid())
  agencyId    String
  name        String
  description String?
  permissions UserPermission[]
  isActive    Boolean          @default(true)
  createdById String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  // Relations
  agency      Agency           @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  createdBy   User             @relation("CreatedRoles", fields: [createdById], references: [id])
  memberships UserAgencyMembership[]

  // Self-relation many-to-many for viewing reports of other roles
  allowedToViewReportsOf Role[] @relation("RoleReportVisibility")
  reportsViewableBy      Role[] @relation("RoleReportVisibility")

  @@unique([agencyId, name])
  @@index([agencyId])
  @@index([createdById])
  @@map("roles")
}
