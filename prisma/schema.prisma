generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==================== USERS ====================

model Group {
  id        String   @id @default(cuid())
  name      String
  service   Service
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  generalReports DailyGeneralReport[]
  signatureLogs  SignatureLog[]

  @@unique([name, service])
  @@map("groups")
}

model User {
  id        String   @id @default(cuid())
  fullName  String
  role      Role     @default(agent)
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Auth
  username String @unique
  password String

  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id])

  generalReports             DailyGeneralReport[]         @relation("GeneralReportReporter")
  readGeneralReports         DailyGeneralReport[]         @relation("GeneralReportReader")
  colisNonVus                ColisNonVu[]
  readColisNonVus            ColisNonVu[]                 @relation("ColisNonVuReader")
  colisHorsBordereaux        ColisHorsBordereau[]
  readColisHorsBordereaux    ColisHorsBordereau[]         @relation("ColisHorsBordereauReader")
  erreursDestination         ErreurDestination[]
  readErreursDestination     ErreurDestination[]          @relation("ErreurDestinationReader")
  colisRetardes              ColisRetarde[]
  readColisRetardes          ColisRetarde[]               @relation("ColisRetardeReader")
  colisNonIdentifies         ColisNonIdentifie[]
  readColisNonIdentifies     ColisNonIdentifie[]          @relation("ColisNonIdentifieReader")
  colisTransferes            ColisTransfere[]
  readColisTransferes        ColisTransfere[]             @relation("ColisTransfereReader")
  convoyeursAbsents          ConvoyeurAbsent[]            @relation("ConvoyeurAbsentReporter")
  absentConvoyeurReports     ConvoyeurAbsent[]            @relation("ConvoyeurAbsentUser")
  readConvoyeursAbsents      ConvoyeurAbsent[]            @relation("ConvoyeurAbsentReader")
  bordereauxNonConformes     BordereauNonConforme[]
  readBordereauxNonConformes BordereauNonConforme[]       @relation("BordereauNonConformeReader")
  vehiculesEmbarques         VehiculeEmbarque[]
  readVehiculesEmbarques     VehiculeEmbarque[]           @relation("VehiculeEmbarqueReader")
  signatureLogs              SignatureLog[]
  evaluationsReceived        PersonnelEvaluation[]        @relation("EvaluatedUser")
  evaluationsGiven           PersonnelEvaluation[]        @relation("EvaluatingLeader")
  criteriaCreated            Criterion[]                  @relation("CriteriaCreator")
  attendanceSettingsCreated  AttendanceCriterionSetting[] @relation("AttendanceSettingCreator")

  @@index([groupId])
  @@map("users")
}

enum Role {
  admin
  leader
  subleader
  agent
  convoyer
}

// ==================== DAILY GENERAL REPORT ====================

model DailyGeneralReport {
  id                  String    @id @default(cuid())
  reportDate          DateTime  @db.Date
  service             Service
  isRead              Boolean   @default(false)
  readAt              DateTime?
  personnelPresent    String?   @db.Text
  personnelAbsent     String?   @db.Text
  ambianceGenerale    String?   @db.Text
  problemesRencontres String?   @db.Text
  etatGeneralService  String?   @db.Text
  passationService    String?   @db.Text
  observationGeneral  String?   @db.Text
  createdAt           DateTime  @default(now())

  groupId                String
  group                  Group                  @relation(fields: [groupId], references: [id])
  reportedById           String
  reportedBy             User                   @relation("GeneralReportReporter", fields: [reportedById], references: [id])
  readById               String?
  readBy                 User?                  @relation("GeneralReportReader", fields: [readById], references: [id])
  colisNonVus            ColisNonVu[]           @relation("GeneralReportColisNonVus")
  colisHorsBordereaux    ColisHorsBordereau[]   @relation("GeneralReportColisHorsBordereaux")
  erreursDestination     ErreurDestination[]    @relation("GeneralReportErreursDestination")
  colisRetardes          ColisRetarde[]         @relation("GeneralReportColisRetardes")
  colisNonIdentifies     ColisNonIdentifie[]    @relation("GeneralReportColisNonIdentifies")
  colisTransferes        ColisTransfere[]       @relation("GeneralReportColisTransferes")
  convoyeursAbsents      ConvoyeurAbsent[]      @relation("GeneralReportConvoyeursAbsents")
  bordereauxNonConformes BordereauNonConforme[] @relation("GeneralReportBordereauxNonConformes")
  vehiculesEmbarques     VehiculeEmbarque[]     @relation("GeneralReportVehiculesEmbarques")

  @@unique([reportDate, service])
  @@index([groupId])
  @@map("daily_general_reports")
}

enum Service {
  envoi
  piste
  retrait
}

// ==================== RAPPORTS INCIDENTS ====================

// Piste
model VehiculeEmbarque {
  id         String    @id @default(cuid())
  reportDate DateTime  @db.Date
  isRead     Boolean   @default(false)
  readAt     DateTime?

  immatriculation      String?
  destination          String?
  heure                DateTime?
  retourReceptionColis String?   @db.Text
  presenceConvoyeurs   String?   @db.Text
  createdAt            DateTime  @default(now())

  reportedById    String
  reportedBy      User                @relation(fields: [reportedById], references: [id])
  readById        String?
  readBy          User?               @relation("VehiculeEmbarqueReader", fields: [readById], references: [id])
  generalReportId String?
  generalReport   DailyGeneralReport? @relation("GeneralReportVehiculesEmbarques", fields: [generalReportId], references: [id])

  @@map("vehicules_embarques")
}

// Piste, envoi
model ColisNonVu {
  id         String    @id @default(cuid())
  reportDate DateTime  @db.Date
  service    Service
  isRead     Boolean   @default(false)
  readAt     DateTime?

  destination         String? // piste
  provenance          String? // piste
  description         String? @db.Text // piste, envoi
  personnesContactees String? @db.Text // piste

  immatriculation String? // envoi
  agenceDepart    String? // envoi
  destinataire    String? // envoi
  actionMenee     String? @db.Text // envoi

  createdAt DateTime @default(now())

  reportedById    String
  reportedBy      User                @relation(fields: [reportedById], references: [id])
  readById        String?
  readBy          User?               @relation("ColisNonVuReader", fields: [readById], references: [id])
  generalReportId String?
  generalReport   DailyGeneralReport? @relation("GeneralReportColisNonVus", fields: [generalReportId], references: [id])

  @@map("colis_non_vus")
}

// Piste
model ColisRetarde {
  id         String    @id @default(cuid())
  reportDate DateTime  @db.Date
  isRead     Boolean   @default(false)
  readAt     DateTime?

  codeColis     String?
  description   String? @db.Text
  destinataire  String?
  motifRetard   String? @db.Text
  actionEnCours String? @db.Text

  createdAt DateTime @default(now())

  reportedById    String
  reportedBy      User                @relation(fields: [reportedById], references: [id])
  readById        String?
  readBy          User?               @relation("ColisRetardeReader", fields: [readById], references: [id])
  generalReportId String?
  generalReport   DailyGeneralReport? @relation("GeneralReportColisRetardes", fields: [generalReportId], references: [id])

  @@map("colis_retardes")
}

// Piste, retrait, et envoi
model ErreurDestination {
  id         String    @id @default(cuid())
  reportDate DateTime  @db.Date
  isRead     Boolean   @default(false)
  readAt     DateTime?

  nom               String? // piste
  telephone         String? // piste, envoi, retrait
  description       String? @db.Text // piste, retrait, envoi
  destinataire      String? // piste
  equipeFacturation String? // piste

  immatriculation    String? // retrait, envoi
  destination        String? // retrait, envoi
  destinationPrevue  String? // retrait, envoi
  destinationErronee String? // retrait, envoi

  createdAt DateTime @default(now())

  reportedById    String
  reportedBy      User                @relation(fields: [reportedById], references: [id])
  readById        String?
  readBy          User?               @relation("ErreurDestinationReader", fields: [readById], references: [id])
  generalReportId String?
  generalReport   DailyGeneralReport? @relation("GeneralReportErreursDestination", fields: [generalReportId], references: [id])

  @@map("erreurs_destination")
}

// Piste
model ColisNonIdentifie {
  id         String    @id @default(cuid())
  reportDate DateTime  @db.Date
  isRead     Boolean   @default(false)
  readAt     DateTime?

  descriptionColis       String? @db.Text
  motifNonIdentification String? @db.Text
  actionMenee            String? @db.Text

  createdAt DateTime @default(now())

  reportedById    String
  reportedBy      User                @relation(fields: [reportedById], references: [id])
  readById        String?
  readBy          User?               @relation("ColisNonIdentifieReader", fields: [readById], references: [id])
  generalReportId String?
  generalReport   DailyGeneralReport? @relation("GeneralReportColisNonIdentifies", fields: [generalReportId], references: [id])

  @@map("colis_non_identifies")
}

// Piste
model ColisTransfere {
  id         String    @id @default(cuid())
  reportDate DateTime  @db.Date
  isRead     Boolean   @default(false)
  readAt     DateTime?

  destination     String?
  numeroBordereau String?
  nombreColis     Int?
  chauffeur       String?
  statut          String?

  createdAt DateTime @default(now())

  reportedById    String
  reportedBy      User                @relation(fields: [reportedById], references: [id])
  readById        String?
  readBy          User?               @relation("ColisTransfereReader", fields: [readById], references: [id])
  generalReportId String?
  generalReport   DailyGeneralReport? @relation("GeneralReportColisTransferes", fields: [generalReportId], references: [id])

  @@map("colis_transferes")
}

// Retrait
model ColisHorsBordereau {
  id         String    @id @default(cuid())
  reportDate DateTime  @db.Date
  isRead     Boolean   @default(false)
  readAt     DateTime?

  agenceDepart      String? // retrait, envoi
  description       String? @db.Text // retrait, envoi
  destinataire      String? // retrait, envoi
  destinatairePhone String? // retrait, envoi
  actionMenee       String? @db.Text // retrait

  createdAt DateTime @default(now())

  reportedById    String
  reportedBy      User                @relation(fields: [reportedById], references: [id])
  readById        String?
  readBy          User?               @relation("ColisHorsBordereauReader", fields: [readById], references: [id])
  generalReportId String?
  generalReport   DailyGeneralReport? @relation("GeneralReportColisHorsBordereaux", fields: [generalReportId], references: [id])

  @@map("colis_hors_bordereaux")
}

// Envoi
model ConvoyeurAbsent {
  id         String    @id @default(cuid())
  reportDate DateTime  @db.Date
  isRead     Boolean   @default(false)
  readAt     DateTime?

  nom              String?
  numero           String?
  vehicule         String?
  agenceProvenance String?

  createdAt DateTime @default(now())

  userId          String?
  user            User?               @relation("ConvoyeurAbsentUser", fields: [userId], references: [id])
  reportedById    String
  reportedBy      User                @relation("ConvoyeurAbsentReporter", fields: [reportedById], references: [id])
  readById        String?
  readBy          User?               @relation("ConvoyeurAbsentReader", fields: [readById], references: [id])
  generalReportId String?
  generalReport   DailyGeneralReport? @relation("GeneralReportConvoyeursAbsents", fields: [generalReportId], references: [id])

  @@map("convoyeurs_absents")
}

// Envoi
model BordereauNonConforme {
  id                 String    @id @default(cuid())
  reportDate         DateTime  @db.Date
  isRead             Boolean   @default(false)
  readAt             DateTime?
  numeroBordereau    String?
  motifNonConformite String?   @db.Text
  actionMenee        String?   @db.Text
  createdAt          DateTime  @default(now())

  reportedById    String
  reportedBy      User                @relation(fields: [reportedById], references: [id])
  readById        String?
  readBy          User?               @relation("BordereauNonConformeReader", fields: [readById], references: [id])
  generalReportId String?
  generalReport   DailyGeneralReport? @relation("GeneralReportBordereauxNonConformes", fields: [generalReportId], references: [id])

  @@map("bordereaux_non_conformes")
}

// ==================== SLIP SIGNATURES ====================

model SignatureLog {
  id             String    @id @default(cuid())
  slipNumber     String
  signedAt       DateTime?
  busArrivalTime DateTime?
  createdAt      DateTime  @default(now())

  groupId String
  group   Group  @relation(fields: [groupId], references: [id])
  userId  String
  user    User   @relation(fields: [userId], references: [id])

  @@index([groupId])
  @@map("signature_log")
}

// ==================== EVALUATION SYSTEM ====================

model Criterion {
  id            String   @id @default(cuid())
  name          String
  impact        Impact
  defaultWeight Decimal  @db.Decimal(5, 2)
  maxDaily      Int?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  createdById        String
  createdBy          User                         @relation("CriteriaCreator", fields: [createdById], references: [id])
  evaluations        PersonnelEvaluation[]
  attendanceSettings AttendanceCriterionSetting[]

  @@map("criteria")
}

enum Impact {
  POSITIVE
  NEGATIVE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

model AttendanceCriterionSetting {
  id        String           @id @default(cuid())
  status    AttendanceStatus
  createdAt DateTime         @default(now())

  criterionId String
  criterion   Criterion @relation(fields: [criterionId], references: [id])
  createdById String
  createdBy   User      @relation("AttendanceSettingCreator", fields: [createdById], references: [id])

  @@unique([criterionId, status])
  @@map("attendance_criterion_settings")
}

model PersonnelEvaluation {
  id             String   @id @default(cuid())
  evaluationDate DateTime @db.Date
  weightOverride Decimal? @db.Decimal(5, 2)
  notes          String?  @db.Text
  createdAt      DateTime @default(now())

  userId       String
  user         User      @relation("EvaluatedUser", fields: [userId], references: [id])
  criteriaId   String
  criteria     Criterion @relation(fields: [criteriaId], references: [id])
  recordedById String
  recordedBy   User      @relation("EvaluatingLeader", fields: [recordedById], references: [id])

  @@map("personnel_evaluations")
}
